# NUSXA — haqiqiy fayl serverda: /opt/proxy/sites/avtotez.caddy (umumiy proxy-caddy o'qiydi).
# Bu yerda o'zgartirish serverga o'zi o'tmaydi: kerak bo'lsa o'sha faylni tahrirlab,
#   docker exec proxy-caddy caddy reload --config /etc/caddy/Caddyfile
# bilan qayta yuklang. /opt/proxy boshqa dasturchiga tegishli — o'zgartirishni u bilan kelishing.

avtotez.uz {
	encode zstd gzip
	root * /srv/avtotez/dist/frontend/browser

	# Angular build fayllari nomida xesh bor — uzoq keshlash mumkin; index.html esa doim yangisi
	@hashed path_regexp \.[0-9a-zA-Z]{8,}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}

www.avtotez.uz {
	redir https://avtotez.uz{uri} permanent
}

api.avtotez.uz {
	encode zstd gzip
	reverse_proxy avtotez-api:3000
}
