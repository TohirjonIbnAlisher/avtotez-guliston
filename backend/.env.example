PORT=3000
NODE_ENV=development

# Production'da (masalan Neon/Supabase) DATABASE_URL beriladi.
# Lokal development'da quyidagi DB_* o'zgaruvchilar ishlatiladi.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=avtotez_guliston
DB_SSL=false

# JWT token imzolash uchun maxfiy kalit (production'da albatta almashtiring)
JWT_SECRET=

# Access token (JWT) muddati, daqiqada
JWT_ACCESS_TTL_MINUTES=15
# Refresh token mutlaq muddati, kunda (shundan keyin baribir qayta login)
REFRESH_TOKEN_TTL_DAYS=7
# Shuncha daqiqa faolsizlikdan keyin avtomatik chiqish
SESSION_IDLE_MINUTES=30
